#!/usr/bin/env bash
# The three checks CI runs on the Rust half, run here instead of seven minutes
# later.
#
# CI holds the line three times: `cargo fmt --check` (the tree is formatted, and
# a hand-wrapped line is a diff nobody asked for), `cargo clippy --all-targets
# -- -D warnings` (six warnings once reached the default branch as six build
# failures), and the test suite. All three are cheap once warm, and all three
# are the checks a change can pass locally by simply not running them.
#
#   git commit --no-verify            skips this, deliberately
#   ADFREE_SKIP_HOOKS=1 git commit …  skips it without pretending to be urgent
#
# Only staged Rust changes are worth compiling: a docs or Kotlin commit pays
# nothing.
set -uo pipefail

if [[ -n "${ADFREE_SKIP_HOOKS:-}" ]]; then
    echo "pre-commit: skipped (ADFREE_SKIP_HOOKS)"
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
if ! git diff --cached --name-only | grep -qE '^rust/.*\.(rs|toml)$'; then
    exit 0
fi

cd "$root/rust" || exit 0

# First, because it is the cheapest and the one a machine without a warm build
# can still answer: no compile, just the file as rustfmt would write it.
echo "pre-commit: cargo fmt --check"
if ! cargo fmt --all --check; then
    echo "pre-commit: rustfmt would rewrite the files above — run \`cargo fmt\`" >&2
    exit 1
fi

echo "pre-commit: cargo clippy --all-targets"
if ! cargo clippy --all-targets -- -D warnings; then
    echo "pre-commit: clippy failed — fix the warnings above, or commit with --no-verify" >&2
    exit 1
fi

echo "pre-commit: cargo test --lib"
if ! cargo test --lib; then
    echo "pre-commit: tests failed — the suite runs in CI too, so this is a real failure" >&2
    exit 1
fi
