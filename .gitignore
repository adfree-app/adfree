# Gradle
.gradle/
build/
local.properties
# Kotlin Gradle plugin session data
.kotlin/
# Ktlint's jar, fetched by scripts/check-ktlint.py
.cache/

# Rust build artifacts. They are produced by :app:buildRust (cargo-ndk) and are
# never committed: the crate source in rust/ is the single source of truth.
rust/target/
app/src/main/jniLibs/
*.so

# IDE
.idea/
*.iml
.DS_Store

# Signing material
*.jks
*.keystore
.env

# Android
captures/
.externalNativeBuild/
.cxx/

# Local-only: agent/tool data and the reference APK kept for inspection
.claude/
.codegraph/
adguard.apk

# JavaScript test tooling (Vitest + Playwright, driven by bun — see package.json)
node_modules/

# Screenshots and captures taken while working on a page, never part of the tree
.shot-*.png
.shot-*.jpeg
.shots/
.log.png
Screenshot_*.png
*.tmp.mjs

# Tool caches and local notes that belong to whoever is working here
.perch/
.qoder/
note.txt
*-khc.txt

# Exported session transcripts (tens of megabytes each)
pi-session-*.html

# Benchmarks are built from the tracked sources beside them
bench/dport
bench/flows
bench/probe

# Scratch for driving a Windows test machine from here (probes, patched jars, screenshots)
.tmp-win/
